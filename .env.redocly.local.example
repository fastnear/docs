# Real production-equivalent Reunite build:
PLAN_GATES=replace_with_real_plan_gates_jwt

# Personal Redocly API key for CLI/API operations.
# This is not used by `realm build`.
REDOCLY_AUTHORIZATION=replace_with_redocly_api_key

# Optional local-only fallback when PLAN_GATES is unavailable.
# Valid values: pro, enterprise
REDOCLY_LOCAL_PLAN=enterprise
