{
  "name": "mike-docs",
  "version": "1.0.0",
  "private": true,
  "description": "FastNEAR docs backend and generation workspace",
  "scripts": {
    "check:external-openapi": "node scripts/check-external-openapi.js",
    "sync:apis": "node scripts/sync-external-apis.js",
    "lint": "npm run check:external-openapi && npm run sync:apis",
    "audit:rpc-examples": "node scripts/audit-rpc-examples.js --subset",
    "audit:rpc-examples:all": "node scripts/audit-rpc-examples.js --all-readonly",
    "audit:rpc-example-placeholders": "node scripts/audit-rpc-example-placeholders.js",
    "audit:page-model-routes": "node scripts/audit-page-model-routes.js",
    "audit:structured-graph": "node scripts/audit-structured-graph.js",
    "audit:fastnear-defaults": "node scripts/audit-fastnear-defaults.js",
    "audit:transfers-defaults": "node scripts/audit-transfers-defaults.js",
    "audit:kv-fastdata-defaults": "node scripts/audit-kv-fastdata-defaults.js",
    "audit:neardata-defaults": "node scripts/audit-neardata-defaults.js",
    "audit:transactions-defaults": "node scripts/audit-transactions-defaults.js",
    "audit:description-drift": "node scripts/audit-description-drift.js",
    "audit:description-quality": "node scripts/audit-description-quality.js",
    "audit:description-quality:report": "node scripts/audit-description-quality.js --report",
    "audit:description-quality:strict": "node scripts/audit-description-quality.js --strict",
    "audit:parameter-descriptions": "node scripts/audit-parameter-descriptions.js",
    "audit:parameter-descriptions:strict": "node scripts/audit-parameter-descriptions.js --strict",
    "discover:fastnear-context": "node scripts/discover-fastnear-context.js",
    "discover:transfers-context": "node scripts/discover-transfers-context.js",
    "discover:kv-fastdata-context": "node scripts/discover-kv-fastdata-context.js",
    "discover:rpc-context": "node scripts/discover-rpc-context.js --json",
    "discover:neardata-context": "node scripts/discover-neardata-context.js",
    "discover:transactions-context": "node scripts/discover-transactions-context.js",
    "smoke:operations": "node scripts/test-operations.js",
    "generate-rpc": "node scripts/generate-from-nearcore.js",
    "refresh-examples": "node scripts/refresh-examples.js",
    "standalone:dev": "node scripts/standalone-dev.js",
    "standalone:build": "node scripts/standalone-build.js",
    "verify:workspace": "npm run lint && npm run standalone:build && npm run audit:page-model-routes && npm run audit:structured-graph && npm run audit:rpc-example-placeholders && npm run audit:rpc-examples:all && npm run audit:fastnear-defaults && npm run audit:transfers-defaults && npm run audit:kv-fastdata-defaults && npm run audit:neardata-defaults && npm run audit:transactions-defaults && npm run audit:description-quality:strict && npm run audit:description-drift && npm run audit:parameter-descriptions:strict",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastnear/docs.git"
  },
  "keywords": [
    "near",
    "openapi",
    "documentation",
    "generation"
  ],
  "author": "FastNEAR",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fastnear/docs/issues"
  },
  "homepage": "https://github.com/fastnear/docs#readme",
  "dependencies": {
    "esbuild": "^0.17.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.8.1"
  }
}
