{
  "name": "docs-pipeline",
  "version": "1.0.0",
  "description": "FastNEAR docs pipeline for Redocly-based RPC and API docs",
  "main": " ",
  "scripts": {
    "sync:apis": "node scripts/sync-external-apis.js",
    "preview": "npm run sync:apis && node scripts/refresh-examples.js && ENABLE_SOURCE_MAPS=true npx @redocly/cli preview",
    "preview:headless": "node scripts/toggle-headless.js headless && npm run preview",
    "preview:portal": "node scripts/toggle-headless.js portal && npm run preview",
    "build": "npm run sync:apis && node scripts/run-realm-build.js",
    "lint": "npm run sync:apis && npx @redocly/cli lint",
    "smoke:operations": "node scripts/test-operations.js",
    "smoke:operations:prod": "node scripts/test-operations.js https://fastnear.redocly.app",
    "generate-rpc": "node scripts/generate-from-nearcore.js",
    "refresh-examples": "node scripts/refresh-examples.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastnear/docs-pipeline.git"
  },
  "keywords": [
    "openapi",
    "example",
    "asyncapi",
    "documentation"
  ],
  "author": "FastNEAR",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fastnear/docs-pipeline/issues"
  },
  "homepage": "https://github.com/fastnear/docs-pipeline#readme",
  "dependencies": {
      "@redocly/realm": "0.119.1"
  }
}
